# ==========================================
# PipelineHealer Environment Template
# ==========================================
# Copy to .env and fill values:
#   cp .env.example .env

# ==========================================
# 1) Azure OpenAI / Foundry
# ==========================================
# Endpoint patterns:
# - Azure OpenAI resource:   https://<resource>.openai.azure.com/
# - Azure AI Services:       https://<resource>.cognitiveservices.azure.com/
# - Use the base endpoint only (no extra path)
#
# API version guidance:
# - AZURE_OPENAI_API_VERSION: primary version for the Responses client
#   (.openai.azure.com endpoints). Default: 2025-04-01-preview
# - AZURE_OPENAI_CHAT_API_VERSION: fallback version used by the Chat Completions
#   client when the Responses client is rejected, and as the default for
#   .cognitiveservices.azure.com endpoints. Default: 2024-12-01-preview
# - Check your Azure deployment page for the version shown in the Target URI.
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com/
# Use the deployment name that exists in your Azure OpenAI resource.
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Fallback chat completions version (used when Responses API version is rejected).
AZURE_OPENAI_CHAT_API_VERSION=2024-12-01-preview
# Recommended for local dev (avoids mandatory az login / DefaultAzureCredential).
AZURE_OPENAI_API_KEY=
# Model backend selection scaffold (current runtime path is azure_openai).
# Future-ready values: openai_compatible, custom
LLM_PROVIDER=azure_openai
# OpenAI-compatible provider settings (used when LLM_PROVIDER=openai_compatible)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=
# Optional task-level model/deployment overrides (empty => use provider default)
LLM_MODEL_ANALYSIS=
LLM_MODEL_DIAGNOSIS=
LLM_MODEL_REMEDIATION=
# MCP provider foundation (preview)
MCP_ENABLED=false
MCP_PROVIDER=disabled
MCP_READ_ONLY=true
MCP_TIMEOUT_SECONDS=15
MCP_MAX_RETRIES=1
# Optional per-tool policy overrides:
# format: tool=policy,tool2=policy2
# policy values: disabled|read_only|write_with_approval|auto
# known tools: fetch_failure_context,fetch_runbook_context,publish_artifact,rerun_pipeline
MCP_TOOL_POLICIES=
# Optional owner/repo allowlist for MCP actions (CSV or JSON array)
# Example: MCP_REPO_ALLOWLIST=Canepro/pipelinehealer-demo,Canepro/daynight-admin
MCP_REPO_ALLOWLIST=

# ==========================================
# 2) GitHub Access
# ==========================================
# Local dev path: use PAT
GITHUB_PERSONAL_ACCESS_TOKEN=YOUR_GITHUB_PAT
# Webhook signature (set the same secret in GitHub webhook settings)
GITHUB_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
#
# Production app path (optional for local)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_SECRET_NAME=github-app-private-key

# ==========================================
# 3) App Runtime
# ==========================================
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ==========================================
# 4) Phase 2 Security
# ==========================================
# Required for /api/* only when ENVIRONMENT is not development.
API_AUTH_KEY=CHANGE_ME_STRONG_KEY
# Required for admin-only settings read/write endpoints (/api/settings).
ADMIN_API_KEY=CHANGE_ME_ADMIN_KEY
# Auth mode:
# - api_key (default): X-API-Key + X-Admin-Key
# - entra: Authorization: Bearer <token>
# - hybrid: accepts either bearer tokens or key headers
AUTH_MODE=api_key
# Entra settings (used when AUTH_MODE=entra or hybrid)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Optional overrides (derived from tenant by default)
ENTRA_ISSUER=
ENTRA_JWKS_URL=
# Optional audience list (CSV or JSON array). If empty, defaults to:
#   api://<ENTRA_CLIENT_ID>,<ENTRA_CLIENT_ID>
ENTRA_ALLOWED_AUDIENCES=
# Admin role/scope names accepted for settings endpoints in Entra mode.
ENTRA_ADMIN_ROLES=PipelineHealer.Admin
AUDIT_SALT=CHANGE_ME_AUDIT_SALT
VERIFY_WEBHOOK_SIGNATURE=true
# Keep false for easy local iteration; set true if you want strict local webhook checks.
VERIFY_WEBHOOK_SIGNATURE_IN_DEVELOPMENT=false

# Frontend runtime auth/API config (container deployments):
# Applied at runtime by compose/Helm/Azure deploy scripts; no frontend image rebuild required.
# For local `bun run dev`, Vite still reads these values directly from process env.
VITE_AUTH_MODE=none
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_AUTHORITY=
VITE_ENTRA_API_SCOPE=
VITE_ENTRA_REDIRECT_URI=
VITE_ENTRA_POST_LOGOUT_REDIRECT_URI=
VITE_API_URL=
# Optional fallback key for direct API URL usage from browser (generally prefer proxy mode).
VITE_API_AUTH_KEY=
VITE_API_TIMEOUT_MS=15000

# ==========================================
# 5) CORS
# ==========================================
# Exact allow-list (CSV or JSON array).
# CSV example:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://myapp.example.com
# JSON example:
# CORS_ALLOWED_ORIGINS=["http://localhost:3000","https://myapp.example.com"]
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Regex for dynamic deploy hosts (for example Azure Container Apps).
CORS_ALLOW_ORIGIN_REGEX=https://.*\\.azurecontainerapps\\.io

# ==========================================
# 6) Agent Behavior
# ==========================================
# safe (recommended): dependency/lint PRs, other scenarios issue-first
# demo: more aggressive demo actions
# debug: same behavior as safe, with verbose diagnostic logging at each pipeline step
HEAL_MODE=safe
# Keep low in normal use; raise for repeated local demos (for example 10).
MAX_REMEDIATION_ATTEMPTS=3
AUTO_CREATE_PR=true
# Create tracking issue for PR remediations; PR body includes Closes #<n>.
AUTO_CREATE_TRACKING_ISSUE_FOR_PRS=true
# Optional repo allowlist for webhook processing scope (CSV or JSON array).
# Example: PH_ALLOWED_REPOS=Canepro/pipelinehealer-demo,Canepro/another-repo
PH_ALLOWED_REPOS=

# ==========================================
# 6.5) Phase 3 Reliability
# ==========================================
# Per-step timeout for analyze/diagnose/remediate.
PIPELINE_STEP_TIMEOUT_SECONDS=120
# GitHub API transient retry policy (429/5xx + network hiccups).
GITHUB_API_MAX_RETRIES=3
GITHUB_API_RETRY_BASE_SECONDS=0.5
GITHUB_API_RETRY_MAX_SECONDS=8.0
# Prompt log truncation keeps head + tail for better root-cause context.
LOG_PROMPT_MAX_CHARS=18000
LOG_PROMPT_HEAD_CHARS=9000
LOG_PROMPT_TAIL_CHARS=9000
# External diagnostics fast-path budget:
# - keep low (60-90s) to avoid blocking operator flow
# - set wait=0 to skip waiting entirely and rely on async backfill
EXTERNAL_DIAGNOSTICS_WAIT_SECONDS=60
EXTERNAL_DIAGNOSTICS_POLL_INTERVAL_SECONDS=15

# ==========================================
# 7) Optional Cloud Services
# ==========================================
COSMOS_DB_ENDPOINT=
COSMOS_DB_DATABASE=pipelinehealer
KEY_VAULT_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=
