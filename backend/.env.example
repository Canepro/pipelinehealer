# ==========================================
# PipelineHealer Environment Template
# ==========================================
# Copy to .env and fill values:
#   cp .env.example .env

# ==========================================
# 1) Azure OpenAI / Foundry
# ==========================================
# Endpoint patterns:
# - Azure OpenAI resource:   https://<resource>.openai.azure.com/
# - Azure AI Services:       https://<resource>.cognitiveservices.azure.com/
# - Use the base endpoint only (no extra path)
#
# API version guidance:
# - For .openai.azure.com (Responses client): usually 2025-03-01-preview or later
# - For .cognitiveservices.azure.com (Chat completions): use your deployment page version
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com/
# Use the deployment name that exists in your Azure OpenAI resource.
# Current dev deployment in this project: gpt-5-mini
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini
AZURE_OPENAI_API_VERSION=2025-03-01-preview
# Recommended for local dev (avoids mandatory az login / DefaultAzureCredential).
AZURE_OPENAI_API_KEY=

# ==========================================
# 2) GitHub Access
# ==========================================
# Local dev path: use PAT
GITHUB_PERSONAL_ACCESS_TOKEN=YOUR_GITHUB_PAT
# Webhook signature (set the same secret in GitHub webhook settings)
GITHUB_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
#
# Production app path (optional for local)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_SECRET_NAME=github-app-private-key

# ==========================================
# 3) App Runtime
# ==========================================
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ==========================================
# 4) Phase 2 Security
# ==========================================
# Required for /api/* only when ENVIRONMENT is not development.
API_AUTH_KEY=CHANGE_ME_STRONG_KEY
VERIFY_WEBHOOK_SIGNATURE=true
# Keep false for easy local iteration; set true if you want strict local webhook checks.
VERIFY_WEBHOOK_SIGNATURE_IN_DEVELOPMENT=false

# ==========================================
# 5) CORS
# ==========================================
# Exact allow-list (CSV or JSON array).
# CSV example:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://myapp.example.com
# JSON example:
# CORS_ALLOWED_ORIGINS=["http://localhost:3000","https://myapp.example.com"]
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Regex for dynamic deploy hosts (for example Azure Container Apps).
CORS_ALLOW_ORIGIN_REGEX=https://.*\\.azurecontainerapps\\.io

# ==========================================
# 6) Agent Behavior
# ==========================================
# safe (recommended): dependency/lint PRs, other scenarios issue-first
# demo: more aggressive demo actions
HEAL_MODE=safe
# Keep low in normal use; raise for repeated local demos (for example 10).
MAX_REMEDIATION_ATTEMPTS=3
AUTO_CREATE_PR=true
# Create tracking issue for PR remediations; PR body includes Closes #<n>.
AUTO_CREATE_TRACKING_ISSUE_FOR_PRS=true

# ==========================================
# 6.5) Phase 3 Reliability
# ==========================================
# Per-step timeout for analyze/diagnose/remediate.
PIPELINE_STEP_TIMEOUT_SECONDS=120
# GitHub API transient retry policy (429/5xx + network hiccups).
GITHUB_API_MAX_RETRIES=3
GITHUB_API_RETRY_BASE_SECONDS=0.5
GITHUB_API_RETRY_MAX_SECONDS=8.0
# Prompt log truncation keeps head + tail for better root-cause context.
LOG_PROMPT_MAX_CHARS=18000
LOG_PROMPT_HEAD_CHARS=9000
LOG_PROMPT_TAIL_CHARS=9000

# ==========================================
# 7) Optional Cloud Services
# ==========================================
COSMOS_DB_ENDPOINT=
COSMOS_DB_DATABASE=pipelinehealer
KEY_VAULT_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=
