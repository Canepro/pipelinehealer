# PipelineHealer Environment Variables
# Copy this file to .env and fill in the values

# Azure OpenAI Configuration
#
# Two common endpoint patterns:
# 1) Azure OpenAI resource (classic): https://<resource>.openai.azure.com/
#    - Recommended with Agent Framework Responses client
#    - Use: AZURE_OPENAI_API_VERSION=2025-03-01-preview (or later)
#
# 2) Azure AI Services (Foundry often uses this): https://<resource>.cognitiveservices.azure.com/
#    - In this project, these endpoints are used with Azure OpenAI Chat Completions
#    - Set AZURE_OPENAI_API_VERSION to the version shown in your deployment page
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2025-03-01-preview
# Recommended for local dev (avoids needing `az login` / DefaultAzureCredential):
AZURE_OPENAI_API_KEY=

# Azure Cosmos DB Configuration
COSMOS_DB_ENDPOINT=https://your-cosmos.documents.azure.com:443/
COSMOS_DB_DATABASE=pipelinehealer

# Azure Key Vault Configuration
KEY_VAULT_URL=https://your-keyvault.vault.azure.net/

# GitHub Configuration
GITHUB_APP_ID=your-github-app-id
GITHUB_WEBHOOK_SECRET=your-webhook-secret
GITHUB_PRIVATE_KEY_SECRET_NAME=github-app-private-key

# For local development (use PAT instead of GitHub App)
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_token_here

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Application Insights (optional for local dev)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Agent Configuration
#
# 'safe' (Recommended): conservative fixes (dependency/lint PRs, otherwise issues)
# 'demo': more aggressive demo behavior (for example retry flaky tests, bump workflow timeouts, etc.)
HEAL_MODE=safe
MAX_REMEDIATION_ATTEMPTS=3
AUTO_CREATE_PR=true
# When PipelineHealer opens a PR, also open a tracking issue and include "Closes #<n>"
# in the PR body so GitHub auto-closes the issue when the PR merges.
AUTO_CREATE_TRACKING_ISSUE_FOR_PRS=true
