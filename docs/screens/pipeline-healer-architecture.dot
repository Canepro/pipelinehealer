digraph PipelineHealerWorkflow {
  rankdir="LR";
  bgcolor="#1e1e1e";
  node [shape="box" style="filled" fillcolor="#2d2d2d" fontcolor="white" color="#4a4a4a" fontname="Helvetica"];
  edge [color="#888888" fontname="Helvetica"];
  GH [label="GitHub Actions\nworkflow_run.completed" shape="box"];
  JN [label="Jenkins Bridge\nsigned POST /webhook/jenkins" shape="box"];
  WH [label="Webhook Ingress\n/github + /jenkins" shape="box"];
  WF [label="PipelineHealerWorkflow" shape="box"];
  OR [label="Orchestrator Agent" shape="box"];
  LA [label="Log Analyzer Agent" shape="box"];
  DG [label="Diagnosis Agent" shape="box"];
  RM [label="Remediation Agent" shape="box"];
  GT [label="Provider Tools / Adapters" shape="box"];
  PR [label="Create PR" shape="box"];
  IS [label="Create Issue" shape="box"];
  RR [label="Re-run Failed Jobs" shape="box"];
  HO [label="Assign-to-Agent\nHandoff" shape="box"];
  ADP [label="GHAW Adapter\npassive mode" shape="box"];
  CD [label="ci-doctor\nissue/comment findings" shape="box"];
  EXT [label="External diagnostics\ncontext" shape="box"];
  BF [label="Backfill Sweep\nevery 10 min" shape="box"];
  ST [label="Cosmos DB / PostgreSQL /\nIn-Memory Storage" shape="cylinder"];
  UI [label="Settings + Control Center" shape="box"];
  API [label="/api/settings*" shape="box"];
  GH -> WH;
  JN -> WH;
  WH -> WF;
  WF -> OR;
  OR -> LA;
  LA -> DG;
  OR -> ADP;
  ADP -> CD;
  CD -> EXT;
  EXT -> DG;
  DG -> RM;
  RM -> GT;
  GT -> PR;
  GT -> IS;
  GT -> RR;
  GT -> HO;
  OR -> ST;
  BF -> ADP;
  BF -> ST;
  UI -> API;
  API -> OR;
  API -> ST;
}
